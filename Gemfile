# frozen_string_literal: true

# The same gem set GitHub Pages uses to build this site from the master
# branch, so a local build matches production. It brings in Jekyll,
# jekyll-remote-theme (for remote_theme in _config.yml), jekyll-paginate and
# jekyll-sitemap.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"
